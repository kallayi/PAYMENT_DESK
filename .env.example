# Supabase Configuration for INDFURN Payment Desk
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-placeholder

# Server-Only Service Role Key (Used exclusively by server helpers & Admin actions)
# NEVER prefix with NEXT_PUBLIC_ or expose to client bundles
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-placeholder

# Web Push VAPID Configuration
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key-placeholder
VAPID_PRIVATE_KEY=your-vapid-private-key-placeholder
VAPID_SUBJECT=mailto:admin@your-company.com

# Vercel Cron Secret (Fail-closed bearer token for /api/cron/reminder-alerts)
CRON_SECRET=your-long-random-cron-secret-placeholder
