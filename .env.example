# Supabase Configuration for INDFURN PayFlow
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-placeholder

# Server-Only Service Role Key (Used exclusively by Owner for secure account provisioning)
# NEVER prefix with NEXT_PUBLIC_ or expose to client bundles
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-placeholder
